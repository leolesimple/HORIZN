# PRIM API Key (obligatoire)
# Obtenir un jeton sur https://prim.iledefrance-mobilites.fr
PRIM_API_KEY=SA2g...

# Port d'écoute (défaut: 3000)
PORT=3000

# Chemin vers le fichier des arrêts
# Défaut: ./json/arrets-stopPoint.json (18 Mo)
STOPS_MAP_PATH=./json/arrets-stopPoint.json

# Mode silencieux (pas d'ASCII art au démarrage)
QUIET_MODE=false
