# HORIZN — Configuration
# Copier vers .env et ajuster

# === OBLIGATOIRE ===

# Clé API PRIM (Île-de-France Mobilités)
# Obtenir un jeton sur https://prim.iledefrance-mobilites.fr
PRIM_API_KEY=SA2g...

# Clés API pour l'authentification serveur-à-serveur (header X-API-Key)
# Séparer par des virgules pour plusieurs clés
API_KEYS=key1,key2

# === OPTIONNEL ===

# Port d'écoute (défaut: 3003)
PORT=3003

# Chemin vers le fichier des arrêts (défaut: ./json/arrets-stopPoint.json)
STOPS_MAP_PATH=./json/arrets-stopPoint.json

# Chemin vers la DB GTFS (défaut: ./data/infostation.db)
DATABASE_PATH=./data/infostation.db

# Chemin vers le ZIP GTFS (défaut: ./data/gtfs.zip)
GTFS_ZIP_PATH=./data/gtfs.zip

# Secret JWT pour les tokens utilisateurs (optionnel)
# Générer avec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Durée de validité des JWT (défaut: 7d)
JWT_EXPIRES_IN=7d

# Mode silencieux (pas d'ASCII art au démarrage)
QUIET_MODE=false
